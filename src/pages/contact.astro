---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Contact"
  description="Contact HomeBillCuts — questions, corrections, and partnership notes."
  canonicalPath="/contact/"
>
  <article class="prose">
    <h1>Contact</h1>
    <p>
      For corrections, feedback, or press inquiries, email:
      <strong>hello@homebillcuts.com</strong>
      <!-- Replace with your real inbox when ready -->
    </p>
    <p>
      We read messages, but response times vary. Please do not send urgent safety questions —
      if you smell gas, see damaged wiring, or suspect a carbon monoxide issue, contact your
      utility’s emergency line or local emergency services immediately.
    </p>
    <p>
      Partnership / affiliate notes: see our <a href="/disclosure/">Disclosure</a> and
      <a href="/privacy/">Privacy Policy</a>.
    </p>
  </article>
</BaseLayout>

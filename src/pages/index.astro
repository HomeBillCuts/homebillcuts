---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { categories, heroPhoto, guides, type CategoryId } from '../data/guides';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts.slice(0, 6);

const featuredIds = [
  'heat-pump-aux-heat-high-bill-thermostat-settings',
  'space-heater-cost-to-run-ceramic-vs-infrared-vs-oil-filled',
  'best-weatherstripping-draft-stoppers',
  'thermostat-setback-savings-math-per-degree',
  'window-insulation-kits-winter-drafts',
  'kill-a-watt-plug-in-energy-meter',
];
const featured = featuredIds.map((id) => posts.find((p) => p.id === id)).filter(Boolean) as typeof posts;
const counts = Object.fromEntries(
  (Object.keys(categories) as CategoryId[]).map((c) => [c, posts.filter((p) => guides[p.id]?.category === c).length]),
);
const checklist = posts.find((p) => p.id === 'lower-electric-bill-priority-checklist');
---
<BaseLayout
  title="HomeBillCuts"
  description="Plain-English guides to lowering your home energy bills: find where the money goes, fix the cheap things first, and buy only what pays off."
  canonicalPath="/"
>
  <div class="wrap">
    <section class="hero">
      <div>
        <p class="eyebrow">Home energy, minus the guesswork</p>
        <h1>Lower bills start with <em>knowing</em> where the heat goes.</h1>
        <p>
          Short, practical guides for US homes. Find the leak or the power hog first, fix what's cheap,
          and only then decide what's worth buying.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href="/start-here/">Start here</a>
          <a class="button button--secondary" href="/blog/">Browse all guides</a>
        </div>
      </div>
      <div class="hero-photo">
        <Image quality={70} src={heroPhoto.src} alt={heroPhoto.alt} widths={[600, 900, 1200]} sizes="(max-width: 860px) 100vw, 560px" loading="eager" fetchpriority="high" />
      </div>
    </section>

    <section class="section" aria-labelledby="topics">
      <div class="section-head"><h2 id="topics">Browse by topic</h2></div>
      <div class="cat-grid">
        {(Object.entries(categories) as [CategoryId, (typeof categories)[CategoryId]][]).map(([id, c]) => (
          <a class="cat" href={`/blog/#${id}`}>
            <Image quality={70} src={c.photo} alt={c.alt} widths={[400, 640]} sizes="(max-width: 640px) 100vw, 300px" loading="lazy" />
            <div><strong>{c.name}</strong><span>{counts[id]} guides · {c.blurb}</span></div>
          </a>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="season">
      <div class="section-head">
        <h2 id="season">Worth reading before the cold sets in</h2>
        <a href="/start-here/">Reading order →</a>
      </div>
      {featured[0] && <PostCard post={featured[0]} lead />}
      <div class="card-grid">
        {featured.slice(1).map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <section class="band" aria-label="How we write these guides">
      <div><div class="num">1</div><h3>Measure first</h3><p>A $25 plug meter or a stick of incense often tells you more than a new gadget.</p></div>
      <div><div class="num">2</div><h3>Fix the cheap things</h3><p>Drafts, setpoints and filters usually come before anything with a plug.</p></div>
      <div><div class="num">3</div><h3>Buy only what pays off</h3><p>We show the math for typical homes so you can run it for yours.</p></div>
    </section>

    <section class="section" aria-labelledby="latest">
      <div class="section-head">
        <h2 id="latest">New this month</h2>
        <a href="/blog/">All {posts.length} guides →</a>
      </div>
      <div class="card-grid">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
      {checklist && (
        <p class="note" style="margin-top:2.5rem">
          Not sure where to begin? The <a href={`/blog/${checklist.id}/`}>priority checklist</a> ranks the free and cheap steps first.
        </p>
      )}
    </section>
  </div>
</BaseLayout>

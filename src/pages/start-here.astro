---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, guides, type CategoryId } from '../data/guides';

const order = ['lower-electric-bill-priority-checklist', 'hvac-air-filters-merv-efficiency', 'best-weatherstripping-draft-stoppers', 'air-sealing-caulk-foam-outlet-gaskets', 'fireplace-chimney-draft-blockers', 'window-insulation-kits-winter-drafts', 'thermal-blackout-curtains-energy-savings', 'insulate-hot-water-pipes-water-heater-jacket', 'low-flow-showerheads-faucet-aerators', 'led-bulbs-save-money-wattage-guide', 'best-smart-plugs-vampire-power', 'best-smart-thermostats-2026', 'smart-thermostat-install-cost-vs-diy', 'kill-a-watt-plug-in-energy-meter', 'emporia-vue-vs-sense', 'attic-stair-hatch-insulation-covers', 'attic-insulation-approaches-when-to-call-pro', 'heat-pump-water-heater-vs-standard', 'window-ac-smart-controllers-ceiling-fan-savings', 'garage-door-weather-seals-bottom-seals', 'oil-filled-space-heaters-zone-heating', 'dryer-vent-cleaning-kits-energy-fire-safety', 'heated-mattress-pads-zone-heating', 'electric-water-heater-timers-cut-standby', 'pipe-freeze-heat-tape-protection', 'window-ac-winter-covers-draft-sealing', 'furnace-humidifier-water-panels-winter-comfort', 'outdoor-faucet-covers-freeze-protection', 'electric-baseboard-heater-thermostats-line-voltage', 'radiator-heat-reflectors-exterior-walls', 'register-booster-fans-cold-rooms', 'whole-house-fan-winter-covers', 'crawl-space-vent-covers-winter', 'recessed-light-covers-attic-air-sealing', 'rim-joist-band-joist-insulation-basement', 'sliding-glass-door-draft-sealing-winter', 'duct-sealing-mastic-foil-tape-hvac', 'indoor-clothes-drying-racks-cut-dryer-cost', 'under-desk-heaters-foot-warmers-home-office', 'cellular-honeycomb-shades-winter-heat-loss', 'air-fryer-toaster-oven-vs-oven-energy-cost', 'plug-in-thermostats-space-heaters', 'thermal-camera-vs-infrared-thermometer-find-drafts', 'space-heater-cost-to-run-ceramic-vs-infrared-vs-oil-filled', 'heat-pump-aux-heat-high-bill-thermostat-settings', 'refrigerator-freezer-cost-to-run-thermometer-coil-brush', 'dehumidifier-cost-to-run-basement-humidity', 'electric-kettle-vs-stove-microwave-cost-to-boil-water', 'holiday-lights-cost-to-run-led-vs-incandescent-timers', 'slow-cooker-vs-instant-pot-vs-oven-cost-to-run', 'electric-blanket-heated-throw-cost-to-run', 'humidifier-cost-to-run-ultrasonic-vs-evaporative-vs-warm-mist', 'tv-gaming-console-pc-cost-to-run-standby', 'electric-fireplace-cost-to-run-heat-vs-flame-only', 'thermostat-setback-savings-math-per-degree', 'washer-dryer-cost-per-load-cold-wash-vs-hot-dryer', 'hot-tub-cost-to-run-winter-cover-thermal-blanket', 'garage-heater-cost-to-run-electric-vs-propane', 'roof-heat-cable-cost-to-run-ice-dams', 'heated-pet-bed-water-bowl-cost-to-run', ];
const all = await getCollection('blog', ({ data }) => data.draft !== true);
const byId = Object.fromEntries(all.map((p) => [p.id, p]));
const ordered = [...order, ...all.map((p) => p.id).filter((id) => !order.includes(id))].filter((id) => byId[id]);
const first = ordered.slice(0, 6);
const rest = ordered.slice(6);
const groups = (Object.keys(categories) as CategoryId[])
  .map((c) => ({ id: c, ...categories[c], ids: rest.filter((id) => guides[id]?.category === c) }))
  .filter((g) => g.ids.length);
const short = (id: string) => byId[id].data.title.split(':')[0].trim();
---
<BaseLayout
  title="Start Here"
  description="New to HomeBillCuts? Start with these six guides, then pick the topic that matches your home."
  canonicalPath="/start-here/"
>
  <div class="wrap">
    <div class="prose" style="margin:0 auto">
      <header class="page-head" style="padding-bottom:0">
        <p class="eyebrow">Start here</p>
        <h1>Where to begin</h1>
        <p>
          Most homes waste the most money in a few predictable places. Read these six first, in order:
          they cost little or nothing and tell you whether anything else is worth buying.
        </p>
      </header>
      <div class="hub-list">
        {first.map((id) => (
          <div class="hub-item">
            <h3><a href={`/blog/${id}/`}>{short(id)}</a></h3>
            <p>{guides[id]?.dek}</p>
          </div>
        ))}
      </div>

      <h2>Then pick your topic</h2>
      <p>Go to whatever is bothering you most: a cold room, a high electric bill, a drafty door.</p>
      {groups.map((g) => (
        <section>
          <h3 id={g.id}>{g.name}</h3>
          <ul>
            {g.ids.map((id) => (
              <li><a href={`/blog/${id}/`}>{short(id)}</a>. {guides[id]?.dek}</li>
            ))}
          </ul>
        </section>
      ))}

      <h2>Four rules we follow</h2>
      <ol>
        <li>Read your bill first: kWh or therms, your rate and how it changes by season.</li>
        <li>Fix the obvious waste: setpoints, filters, drafts, water heater temperature.</li>
        <li>Measure before you upgrade. A plug-in meter or your utility's usage data beats a guess.</li>
        <li>Leave panel, gas and HVAC electrical work to a licensed pro.</li>
      </ol>
    </div>
  </div>
</BaseLayout>

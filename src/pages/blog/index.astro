---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { categories, guides, type CategoryId } from '../../data/guides';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const groups = (Object.keys(categories) as CategoryId[])
  .map((id) => ({ id, ...categories[id], posts: posts.filter((p) => (guides[p.id]?.category ?? 'electricity') === id) }))
  .filter((g) => g.posts.length);
---
<BaseLayout
  title="Guides"
  description="Every HomeBillCuts guide, grouped by topic: drafts and sealing, heating, insulation, water heating, appliances, kitchen and laundry."
  canonicalPath="/blog/"
>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">{posts.length} guides</p>
      <h1>Guides</h1>
      <p>Grouped by topic. Each one starts with a quick way to check your own home before you spend anything.</p>
    </header>
    <nav class="chips" aria-label="Topics">
      {groups.map((g) => <a href={`#${g.id}`}>{g.name}</a>)}
    </nav>
    {groups.map((g) => (
      <section class="cat-section" id={g.id} aria-labelledby={`h-${g.id}`}>
        <h2 id={`h-${g.id}`}>{g.name}</h2>
        <p>{g.blurb}</p>
        <div class="card-grid">
          {g.posts.map((post) => <PostCard post={post} showImage={false} />)}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

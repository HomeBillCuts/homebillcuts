---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import { guideMeta, guides } from '../data/guides';

interface Props {
  post: CollectionEntry<'blog'>;
  headings?: { depth: number; slug: string; text: string }[];
}

const { post, headings = [] } = Astro.props;
const meta = guideMeta(post.id);
const words = (post.body ?? '').split(/\s+/).length;
const minutes = Math.max(3, Math.round(words / 230));
const toc = headings.filter((h) => h.depth === 2 && !/^(faq|related reading|sources)$/i.test(h.text));
const related = (await getCollection('blog', ({ data }) => data.draft !== true))
  .filter((p) => p.id !== post.id && guides[p.id]?.category === meta.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const { title, description, pubDate, updatedDate, faqs } = post.data;

const formattedPub = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const formattedUpdated = updatedDate
  ? updatedDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })
  : null;

const canonicalPath = `/blog/${post.id}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? 'https://homebillcuts.com').toString();
const dateModified = (updatedDate ?? pubDate).toISOString();

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  author: {
    '@type': 'Organization',
    name: 'HomeBillCuts',
    url: 'https://homebillcuts.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'HomeBillCuts',
    url: 'https://homebillcuts.com',
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://homebillcuts.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Guides',
      item: 'https://homebillcuts.com/blog/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: canonicalUrl,
    },
  ],
};

const jsonLd: Record<string, unknown>[] = [articleLd, breadcrumbLd];
if (faqs && faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}
---
<BaseLayout
  title={title}
  description={meta.dek || description}
  canonicalPath={canonicalPath}
  ogType="article"
  pubDate={pubDate}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <header class="article-head">
      <p class="eyebrow"><a href={`/blog/#${meta.category}`}>{meta.cat.name}</a></p>
      <h1>{title}</h1>
      {meta.dek && <p class="dek">{meta.dek}</p>}
      <p class="byline">
        {formattedUpdated ? <>Updated <time datetime={updatedDate!.toISOString()}>{formattedUpdated}</time></> : <time datetime={pubDate.toISOString()}>{formattedPub}</time>}
        {' · '}{minutes} min read
      </p>
    </header>
    <figure class="article-photo">
      <Image quality={70} src={meta.cat.photo} alt={meta.cat.alt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 1000px) 100vw, 960px" loading="eager" />
    </figure>
    <div class="article-grid">
      <article class="prose">
        <slot />
        <p class="disclosure-line">
          Some links on this page go to Amazon, and we earn a commission if you buy, at no extra cost to you.
          Prices and savings vary by home and utility rate. More in our <a href="/disclosure/">disclosure</a>.
        </p>
        <div class="post-next">
          <a class="button button--primary" href="/start-here/">Start here</a>
          <a class="button button--secondary" href="/blog/">All guides</a>
        </div>
      </article>
      {toc.length > 2 && (
        <nav class="toc" aria-label="On this page">
          <p>On this page</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
    </div>
  </div>
  {related.length > 0 && (
    <section class="related" aria-labelledby="more">
      <div class="section-head"><h2 id="more">More in {meta.cat.name}</h2><a href={`/blog/#${meta.category}`}>See all →</a></div>
      <div class="card-grid">{related.map((p) => <PostCard post={p} />)}</div>
    </section>
  )}
</BaseLayout>

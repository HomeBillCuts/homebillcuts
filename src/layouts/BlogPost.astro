---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, faqs } = post.data;

const formattedPub = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const formattedUpdated = updatedDate
  ? updatedDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })
  : null;

const canonicalPath = `/blog/${post.id}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? 'https://homebillcuts.com').toString();
const dateModified = (updatedDate ?? pubDate).toISOString();

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  author: {
    '@type': 'Organization',
    name: 'HomeBillCuts',
    url: 'https://homebillcuts.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'HomeBillCuts',
    url: 'https://homebillcuts.com',
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://homebillcuts.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Guides',
      item: 'https://homebillcuts.com/blog/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: canonicalUrl,
    },
  ],
};

const jsonLd: Record<string, unknown>[] = [articleLd, breadcrumbLd];
if (faqs && faqs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}
---
<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  pubDate={pubDate}
  jsonLd={jsonLd}
>
  <article class="prose">
    <p class="meta">
      <time datetime={pubDate.toISOString()}>{formattedPub}</time>
      {formattedUpdated && (
        <>
          {' · '}Updated <time datetime={updatedDate!.toISOString()}>{formattedUpdated}</time>
        </>
      )}
    </p>
    <h1>{title}</h1>
    <slot />
    <hr />
    <p class="amazon-associate">
      As an Amazon Associate I earn from qualifying purchases.
    </p>
    <div class="post-next-actions">
      <a class="button button--primary" href="/start-here/">Start Here hub</a>
      <a class="button button--secondary" href="/blog/">Browse all guides</a>
    </div>
    <p class="post-next-note">
      Prefer the fine print first? Read our <a href="/disclosure/">affiliate disclosure</a>.
    </p>
  </article>
</BaseLayout>

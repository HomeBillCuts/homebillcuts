---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/inter/index.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  pubDate?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = 'Plain-English guides to lowering your home energy bills: what to check first, what is worth buying, and what to skip.',
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  pubDate,
  jsonLd,
  noindex = false,
} = Astro.props;

const siteName = 'HomeBillCuts';
const siteUrl = Astro.site ?? new URL('https://homebillcuts.com');
const canonical = new URL(canonicalPath, siteUrl).toString();
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const pathname = Astro.url.pathname;

const nav = [
  { href: '/blog/', label: 'Guides' },
  { href: '/start-here/', label: 'Start Here' },
  { href: '/about/', label: 'About' },
];

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: siteUrl.toString(),
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteUrl.toString(),
  publisher: {
    '@type': 'Organization',
    name: siteName,
    url: siteUrl.toString(),
  },
};

const extraLd = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
const jsonLdBlocks = [organizationLd, websiteLd, ...extraLd];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="HomeBillCuts RSS" href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">Home<span>Bill</span>Cuts</a>
        <nav class="nav" aria-label="Primary">
          {nav.map((item) => (
            <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <a class="logo" href="/">Home<span>Bill</span>Cuts</a>
          <p style="margin-top:.75rem">
            Practical guides for US households. We earn a commission from some Amazon links, at no
            cost to you. Savings depend on your home, climate and rates, so we show the math instead of promises.
          </p>
        </div>
        <nav class="footer-nav" aria-label="Footer">
          <a href="/blog/">Guides</a>
          <a href="/start-here/">Start Here</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/privacy/">Privacy</a>
          <a href="/disclosure/">Disclosure</a>
          <a href="/credits/">Photo credits</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <p class="credits">© {new Date().getFullYear()} HomeBillCuts. As an Amazon Associate I earn from qualifying purchases.</p>
      </div>
    </footer>
  </body>
</html>
